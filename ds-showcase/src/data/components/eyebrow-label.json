  "usage": {
    "purpose": "Un eyebrow label marca fase o contexto («Próximo viaje», «En destino», «Recuerdo») sin ser pulsable. Sustituye al Assist chip cuando el fondo es una foto o un scrim y el outline no garantiza contraste. Los chips siguen siendo filtros y acciones.",
    "when": [
      "Hay que nombrar la fase de un viaje o una categoría editorial.",
      "El fondo es variable (portada, scrim) o una superficie plana de card.",
      "El texto se anuncia en el bloque padre: el label no es un control."
    ],
    "whenNot": [
      {
        "case": "Filtrar o seleccionar una opción",
        "use": "Filter chip",
        "href": "components/filter-chip.html"
      },
      {
        "case": "Ejecutar una acción",
        "use": "Button",
        "href": "components/button.html"
      }
    ],
    "chooseVariant": [
      {
        "if": "Sobre foto o scrim (TripHeroCard)",
        "use": "EyebrowLabelColor.Tertiary",
        "note": "tertiaryFixedDim + onTertiaryContainer. Size Medium por defecto."
      },
      {
        "if": "Sobre surface, sin foto",
        "use": "EyebrowLabelColor.Surface o Secondary",
        "note": "Small si el espacio es corto."
      }
    ],
    "related": [
      {
        "label": "TripHeroCard",
        "href": "components/trip-hero-card.html"
