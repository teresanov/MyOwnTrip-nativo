  "anatomy": [
    "<strong>Contenedor</strong> — se ajusta al texto; radio 8 dp (shapes.small), sin borde ni sombra. Relleno de 8 dp a los lados en Medium y de 16 dp en Small; 4 dp arriba y abajo.",
    "<strong>Etiqueta</strong> — labelMedium (Medium) o labelSmall (Small), una línea con puntos suspensivos si no cabe."
  ],
  "behavior": {
    "lead": "No es un chip. No tiene onClick, ripple ni estado selected.",
    "rows": [
      {
        "state": "Siempre estático",
        "detail": "hideFromAccessibility en Compose: el padre ya anuncia la fase."
      }
    ],
    "notes": [
      "Padding Compose: Medium 8×4 dp, Small 16×4 dp (así está el composable)."
    ]
  },
  "a11y": [
    "Decorativo: semantics hideFromAccessibility si el padre incluye la fase.",
    "Nunca role Button.",
    "Contraste ≥ 4.5:1 label sobre contenedor en los tres colores."
